{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug train_dsa.py",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/trainer/train_dsa.py",
      "cwd": "${workspaceFolder}/trainer",
      "args": [
        "--batch_size=32",
        "--from_weight=pretrain",
        "--save_weight=dsa_warmup",
        "--dsa_lambda=0.0001",
