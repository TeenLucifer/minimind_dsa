      ],
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Debug eval_llm.py",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/eval_llm.py",
      "cwd": "${workspaceFolder}",
      "args": [
        "--weight=dsa_joint",
        "--use_dsa=1",
        "--freeze_base=0",
      ],
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ]
}